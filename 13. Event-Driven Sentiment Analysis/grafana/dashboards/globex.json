{
  "title": "Globex — Product Review Sentiment (demo)",
  "uid": "m13-globex-sentiment",
  "schemaVersion": 40,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Mean sentiment by category",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "globex-sentiment"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"review_sentiment\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"review_sentiment\" and r._field == \"score\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> group(columns: [\"category\"])",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Sentiment score — recent reviews",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "globex-sentiment"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"review_sentiment\") |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"review_sentiment\" and r._field == \"score\") |> keep(columns: [\"_time\",\"category\",\"_value\"]) |> sort(columns: [\"_time\"], desc: true) |> limit(n: 40)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
